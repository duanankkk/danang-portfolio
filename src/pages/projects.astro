---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    name: 'Centrifugal Pump Performance Evaluation',
    year: '2025',
    role: 'Process Engineer Intern — PT Kilang Pertamina Internasional (RU IV Cilacap)',
    tags: ['Process Engineering', 'Refinery'],
    points: [
      "Investigated underperformance in pump 31P1, responsible for loading aviation turbine fuel.",
      'Compared real-world operating data against the original design specs to trace where the gap was coming from.',
      'Flagged early cavitation risk via suction pressure and NPSHA — before it turned into downtime.',
    ],
  },
  {
    name: 'Surfactant-Based EOR Research',
    year: '2024–2025',
    role: 'Researcher — Universitas Gadjah Mada',
    tags: ['Research', 'Enhanced Oil Recovery'],
    points: [
      'Tested whether a more eco-friendly surfactant could still perform under real Enhanced Oil Recovery conditions.',
      'Ran 100+ filtration tests across varying concentrations and operating conditions.',
      'Found where Methyl Ester Sulphonate held up, and presented the findings at a departmental seminar.',
    ],
  },
  {
    name: 'Catalyst Competition 2022',
    year: '2022',
    role: 'Event Manager — POISE UGM x Catalyst',
    tags: ['Event Management', 'Leadership'],
    points: [
      'Took ownership of Catalyst, one of POISE UGM’s flagship competitions, from first plan to final winner.',
      'Directed a team of about 8 staff through the entire planning and execution cycle.',
      'Delivered the event on schedule, closing with a declared winner and a team that’d do it again.',
    ],
  },
  {
    name: 'Teknik Fair Workshop',
    year: '2022',
    role: 'Workshop Project Lead / Department Representative',
    tags: ['Leadership', 'Public Speaking'],
    points: [
      'Designed a workshop giving prospective students a real feel for studying Chemical Engineering.',
      'Led a 6-person team through the planning and delivery of the session.',
      'Represented the department as its official delegate throughout the event.',
    ],
  },
];
---

<Layout title="Projects" current="projects">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Selected work</span>
      <h1>Projects<span class="text-red">.</span></h1>
      <p class="lede" style="margin-top: 1.75rem;">
        A few things I've actually gotten my hands dirty with &mdash; inside a refinery, in a
        research lab, and on event teams that needed someone to hold the plan together.
      </p>
    </div>
  </section>

  <section class="section section--border-top project-list">
    <div class="container">
      {
        projects.map((project) => (
          <article class="project-row">
            <div class="project-row__meta">
              <span class="project-row__year">{project.year}</span>
              <ul class="project-row__tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
            <div class="project-row__body">
              <h2>{project.name}</h2>
              <p class="project-row__role">{project.role}</p>
              <ul class="project-row__points">
                {project.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a
                class="project-row__link"
                href="https://linkedin.com/in/danang-haryanto-b87208217"
                target="_blank"
                rel="noopener noreferrer"
              >
                More on LinkedIn &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .project-list .container {
    border-top: 1px solid var(--color-black);
  }

  .project-row {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 2rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--color-black);
  }

  .project-row__year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
  }

  .project-row__tags {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-row__tags li {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-red);
    border: 1px solid var(--color-red);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
  }

  .project-row__body h2 {
    text-transform: none;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 0.4rem;
  }

  .project-row__role {
    font-size: 0.875rem;
    color: #555;
    margin-bottom: 1rem;
  }

  .project-row__points {
    margin: 0;
    padding-left: 1.1rem;
    max-width: 60ch;
    color: #333;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .project-row__link {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--color-black);
    border-bottom: 2px solid var(--color-red);
  }

  @media (max-width: 720px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

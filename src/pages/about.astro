---
import Layout from '../layouts/Layout.astro';

const facts = [
  { label: 'Based in', value: 'Jakarta Timur, Indonesia' },
  { label: 'Education', value: 'B.Eng. Chemical Engineering, UGM (2021–2026)' },
  { label: 'Languages', value: 'English (TOEFL ITP 583), Mandarin (HSK 3)' },
  { label: 'Currently', value: 'Fresh Graduate — Process Engineering' },
];

const experience = [
  {
    role: 'Process Engineer Intern',
    org: 'PT Kilang Pertamina Internasional, Refinery Unit IV — Cilacap, Indonesia',
    period: 'Apr 2025 – May 2025',
    points: [
      'Spent two months inside the Process Engineering section of one of Indonesia’s largest refineries.',
      'Investigated why pump 31P1 wasn’t performing to spec on avtur loading — comparing live operating data against the original design numbers.',
      'Traced the gap to suction pressure and NPSHA, flagging early cavitation risk before it turned into downtime.',
    ],
  },
  {
    role: 'Researcher',
    org: 'Universitas Gadjah Mada — Yogyakarta, Indonesia',
    period: 'Apr 2024 – Feb 2025',
    points: [
      'Explored whether a more eco-friendly surfactant could still hold up under real Enhanced Oil Recovery conditions.',
      'Ran filtration tests across 100+ samples, varying concentration and operating conditions to map where Methyl Ester Sulphonate held its ground.',
      'Packaged the findings into a report and presented them at a departmental seminar.',
    ],
  },
];

const leadership = [
  {
    role: 'Event Manager, Catalyst Competition',
    org: 'POISE UGM x Catalyst',
    period: '2022',
    detail: 'Ran POISE UGM’s flagship competition end to end — an 8-person crew, one winner declared at the finish.',
  },
  {
    role: 'Workshop Project Lead / Department Representative',
    org: 'Teknik Fair',
    period: '2022',
    detail: 'Gave prospective students a real look at studying Chemical Engineering, with a 6-person team behind the scenes.',
  },
  {
    role: 'Project Officer, OTK 2022',
    org: 'KMTK FT UGM',
    period: '2022',
    detail: 'Helped run a national event introducing high schoolers to Chemical Engineering — closed it out with an 8.5/10 feedback score.',
  },
  {
    role: 'Staff, HOPIN',
    org: 'KMTK UGM',
    period: 'Feb 2022 – Feb 2023',
    detail: 'Kept departmental events on track as Liaison Officer and MC — named Best Staff for the 2022–2023 term.',
  },
];

const stats = [
  { value: '8', label: 'Team Members Led' },
  { value: '100+', label: 'EOR Samples Tested' },
  { value: '583', label: 'TOEFL ITP Score' },
  { value: '4', label: 'Leadership Roles' },
];

const skills = {
  Technical: ['Process Engineering', 'Centrifugal Pumps', 'Enhanced Oil Recovery', 'Laboratory Skills', 'HSSE', 'Data Analysis'],
  'Leadership & Management': ['Project Management', 'Event Management', 'Team Leadership', 'Public Speaking', 'Stakeholder Communication'],
};
---

<Layout title="About" current="about">
  <section class="section about-hero">
    <div class="container about-hero__grid">
      <div>
        <span class="eyebrow">About</span>
        <h1>Who I<br />Am<span class="text-red">.</span></h1>
      </div>
      <div class="about-photo" aria-hidden="true">Photo placeholder</div>
    </div>
  </section>

  <section class="section section--border-top">
    <div class="container about-body">
      <div class="about-body__text">
        <p class="lede">
          I studied Chemical Engineering at Universitas Gadjah Mada because I wanted to
          understand how things actually move &mdash; fluids through pipes, heat through
          exchangers, oil through rock. That curiosity took me from a refinery floor in Cilacap
          to a lab bench testing surfactants for Enhanced Oil Recovery.
        </p>
        <p style="margin-top: 1.5rem; max-width: 60ch;">
          Somewhere along the way I also started running things &mdash; events, workshops, teams
          of students who needed a plan and someone to keep it on track. Turns out managing eight
          people toward a deadline isn't that different from managing a process: you still need
          clear inputs, checkpoints, and a way to catch things before they go sideways.
        </p>
      </div>
      <dl class="fact-list">
        {
          facts.map((fact) => (
            <div class="fact-list__row">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section--border-top stats-section">
    <div class="container">
      <ul class="stats-row">
        {
          stats.map((stat) => (
            <li>
              <span class="stats-row__value">{stat.value}</span>
              <span class="stats-row__label">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--border-top">
    <div class="container">
      <span class="eyebrow">Professional experience</span>
      <h2 style="margin-bottom: 3rem;">Experience<span class="text-red">.</span></h2>
      <div class="timeline">
        {
          experience.map((job) => (
            <article class="timeline__item">
              <div class="timeline__meta">
                <span class="timeline__period">{job.period}</span>
              </div>
              <div class="timeline__body">
                <h3>{job.role}</h3>
                <p class="timeline__org">{job.org}</p>
                <ul>
                  {job.points.map((point) => <li>{point}</li>)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--border-top">
    <div class="container">
      <span class="eyebrow">Leadership &amp; organizational experience</span>
      <h2 style="margin-bottom: 3rem;">Leadership<span class="text-red">.</span></h2>
      <div class="leadership-grid">
        {
          leadership.map((role) => (
            <div class="leadership-card">
              <span class="leadership-card__period">{role.period}</span>
              <h3>{role.role}</h3>
              <p class="leadership-card__org">{role.org}</p>
              <p>{role.detail}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--border-top">
    <div class="container">
      <span class="eyebrow">Skills</span>
      <h2 style="margin-bottom: 1rem;">Skills<span class="text-red">.</span></h2>
      <p class="lede" style="margin-bottom: 2.5rem; font-size: 1.0625rem;">What I actually reach for, day to day.</p>
      <div class="skills-grid">
        {
          Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="skills-grid__category">{category}</h3>
              <ul class="tag-list">
                {items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--border-top">
    <div class="container">
      <span class="eyebrow">Get in touch</span>
      <h2 style="margin-bottom: 1.5rem;">Say Hello<span class="text-red">.</span></h2>
      <div class="hero__actions">
        <a class="btn" href="mailto:danangh1412@gmail.com">Email Me</a>
        <a
          class="btn btn--outline"
          href="https://linkedin.com/in/danang-haryanto-b87208217"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: end;
  }

  .about-photo {
    aspect-ratio: 4 / 5;
    background: var(--color-black);
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
  }

  .about-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 4rem;
  }

  .fact-list {
    margin: 0;
    border-top: 1px solid var(--color-black);
  }

  .fact-list__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-black);
  }

  .fact-list__row dt {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 0.8125rem;
    color: var(--color-red);
  }

  .fact-list__row dd {
    margin: 0;
    text-align: right;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Stats */

  .stats-section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: var(--color-black);
    color: var(--color-white);
  }

  .stats-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stats-row__value {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    color: var(--color-red);
    line-height: 1;
  }

  .stats-row__label {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Timeline */

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-black);
  }

  .timeline__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .timeline__period {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1rem;
  }

  .timeline__body h3 {
    text-transform: none;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .timeline__org {
    color: var(--color-red);
    font-size: 0.9rem;
    margin-top: 0.4rem;
    margin-bottom: 1rem;
  }

  .timeline__body ul {
    margin: 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #333;
  }

  /* Leadership */

  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-black);
    border: 1px solid var(--color-black);
  }

  .leadership-card {
    background: var(--color-white);
    padding: 2rem;
  }

  .leadership-card__period {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8125rem;
    color: var(--color-red);
  }

  .leadership-card h3 {
    text-transform: none;
    font-size: 1.375rem;
    margin-top: 0.5rem;
  }

  .leadership-card__org {
    font-size: 0.875rem;
    color: #555;
    margin: 0.35rem 0 0.75rem;
  }

  /* Skills */

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }

  .skills-grid__category {
    text-transform: none;
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tag-list li {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid var(--color-black);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
  }

  @media (max-width: 860px) {
    .about-hero__grid,
    .about-body,
    .leadership-grid,
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .about-photo {
      aspect-ratio: 16 / 9;
    }

    .timeline__item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .stats-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1rem;
    }
  }
</style>
